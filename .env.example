# Configuração de Ambiente - Case Santander Data
# Copie este arquivo para .env e configure os valores

# ============================================
# AMBIENTE (HK ou PROD)
# ============================================
# Ambiente: hk (homologação reduzido) ou prod (produção completa)
ENVIRONMENT=hk

# Confirmação para produção (obrigatório quando ENVIRONMENT=prod)
CONFIRM_PRODUCTION=false

# ============================================
# AZURE RESOURCES
# ============================================
# Azure Storage
STORAGE_ACCOUNT_HK=stcasesantander-hk
STORAGE_ACCOUNT_PROD=stcasesantander

# Azure Key Vault
KEY_VAULT_HK=kv-case-santander-hk
KEY_VAULT_PROD=kv-case-santander

# Event Hub
EVENTHUB_NS_HK=evhcasesantander-hk
EVENTHUB_NS_PROD=evhcasesantander

# SQL Database
SQL_SERVER_HK=sqlsvr-case-santander-hk.database.windows.net
SQL_SERVER_PROD=sqlsvr-case-santander.database.windows.net

# ============================================
# DATABRICKS (para Airflow e Asset Bundles)
# ============================================
# Databricks Host
DATABRICKS_HOST_HK=https://adb-xxx-hk.azuredatabricks.net
DATABRICKS_HOST_PROD=https://adb-xxx.azuredatabricks.net

# Databricks Token
DATABRICKS_TOKEN_HK=your_databricks_token_hk
DATABRICKS_TOKEN_PROD=your_databricks_token_prod

# Databricks Cluster ID
DATABRICKS_CLUSTER_ID_HK=0401-150803-wefgy1hc
DATABRICKS_CLUSTER_ID_PROD=0401-150803-wefgy1hc

# Databricks Repo Path (caminho no workspace)
DATABRICKS_REPO_PATH=/Workspace/Users/diego.silva0001@gmail.com/case-santander-data-master

# ============================================
# API CREDENTIALS (para testes locais)
# ============================================
# Kaggle API Token (novo formato)
KAGGLE_API_TOKEN=your_kaggle_token_here

# ============================================
# RATE LIMITING (requests por minuto)
# ============================================
# HK: Reduzido para economia de custo
API_RATE_LIMIT_YAHOO_HK=15
API_RATE_LIMIT_YAHOO_PROD=30

API_RATE_LIMIT_BCB_HK=45
API_RATE_LIMIT_BCB_PROD=120

API_RATE_LIMIT_WB_HK=90
API_RATE_LIMIT_WB_PROD=300

API_RATE_LIMIT_KAGGLE_HK=5
API_RATE_LIMIT_KAGGLE_PROD=20

# ============================================
# RETENÇÃO DE DADOS (dias)
# ============================================
# HK: 30 dias (reduzido vs 90 dias prod)
DATA_RETENTION_HK=30
DATA_RETENTION_PROD=90

# ============================================
# STREAMING
# ============================================
# HK: Desabilitado para redução de custo
ENABLE_STREAMING_HK=false
ENABLE_STREAMING_PROD=true

# ============================================
# STREAMING PRODUCER: CLIENTE REAL POR TRANSACAO (opcional)
# ============================================
# scripts/eventhub_producer*.py rodam FORA do Databricks. Sem estas 4
# variaveis, cada transacao recebe um hash_cliente SINTETICO ("SYN-nnnn"),
# sem vinculo com bronze.clientes. Com elas, o producer busca uma amostra
# de clientes REAIS exportada por job_exportar_amostra_streaming.
# Nao suffixado por HK/PROD como o resto deste arquivo -- aponte para o
# storage account do ambiente que voce quer simular (valor unico, nao
# um par). Ver scripts/_streaming_clientes.py.
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
AZURE_TENANT_ID=your_tenant_id
STORAGE_ACCOUNT=stcasesantanderhk
